# Claude — question generation, fallback scoring, report summaries
ANTHROPIC_API_KEY=
# Set to 1 to skip Claude and use the built-in heuristic evaluator.
LMS_MOCK_LLM=

# Supabase (Project settings → API). Either key works; the anon key is tried first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never prefix with NEXT_PUBLIC_. Session rows are written with it
# (users can't write them; see supabase/migrations/0004). The service_role key,
# or the newer secret key as SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Eval agent (agents/eval_agent/server.py). Leave the URL empty to score with Claude only.
EVAL_AGENT_URL=http://127.0.0.1:8000
# Same value as EVAL_AGENT_TOKEN in agents/eval_agent/.env
EVAL_AGENT_TOKEN=
